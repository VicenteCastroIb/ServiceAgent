# Copiar a ".env" (gitignorado) y completar con valores reales.
# Nunca commitear el .env real.

# Postgres (defaults ya funcionan con el docker-compose incluido)
DB_URL=jdbc:postgresql://localhost:5432/whatsapp_ai_agent
DB_USERNAME=whatsapp
DB_PASSWORD=whatsapp

# Twilio (cuenta sandbox WhatsApp - Semana 1 del roadmap)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Anthropic (Claude Haiku 4.5 - Semana 2 del roadmap)
ANTHROPIC_API_KEY=

# JWT del panel (Next.js) - Semana 3. Generar con: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# Login del panel (usuario único por ahora)
PANEL_USERNAME=admin
PANEL_PASSWORD=

# CORS: origen(es) del panel que pueden llamar a esta API desde el navegador.
# Separar con comas si hace falta más de uno. Default ya sirve para local.
# PANEL_ALLOWED_ORIGINS=http://localhost:3000

# Plan Catálogo/Ecommerce - Semana 6 (opcionales, ver application.properties para los defaults)
# FLOW_API_BASE_URL=https://sandbox.flow.cl/api
# APP_BASE_URL=http://localhost:8080

# Suscripción SaaS (cobro automático de la mensualidad a los tenants) - cuenta Flow propia, no la de cada tenant
# FLOW_BILLING_API_KEY=
# FLOW_BILLING_SECRET_KEY=

# Canal Instagram (Graph API directa de Meta, no pasa por Twilio) - opcionales
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# INSTAGRAM_GRAPH_API_BASE_URL=https://graph.instagram.com/v21.0

# Plantilla "utility" de recordatorio de WhatsApp (opcional, ver TwilioTemplateService).
# Crear con POST /admin/whatsapp-templates y pegar acá el contentSid recién quede "approved".
# REMINDERS_CONTENT_SID=
# REMINDERS_CONTENT_LANGUAGE=es

# Notificación al dueño por email cuando hay un handoff (opcional, ver OwnerNotificationService).
# Mientras MAIL_SMTP_HOST esté vacío, no se manda ningún email (el handoff se sigue viendo en el panel).
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USERNAME=
# MAIL_SMTP_PASSWORD=
# MAIL_FROM_ADDRESS=
# PANEL_PUBLIC_URL=https://panel.tudominio.cl
