# URL pública del backend (Spring Boot). Solo se usa para POST /public/registro
# (doc sección 12, RegistroForm) - la landing no llama a ningún otro endpoint.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Número de WhatsApp de VENTAS (vos, con código de país, sin "+" ni espacios,
# ej: 56912345678) - a donde llegan los prospectos desde los botones de
# WhatsApp de la landing (WhatsAppFloatButton, CTAs de /precios). No es el
# WhatsApp de ningún negocio cliente.
NEXT_PUBLIC_WHATSAPP_SALES_NUMBER=56956333685

# URL pública del panel (Next.js) desplegado, para el link "Entrar" del header.
NEXT_PUBLIC_PANEL_URL=http://localhost:3000
